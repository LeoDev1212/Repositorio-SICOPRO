DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Contraseña asignada a los usuarios creados por seed_users. Cambia este
# valor (y SECRET_KEY) antes de desplegar a un entorno real.
DEFAULT_USER_PASSWORD=demo123

# Controla si entrypoint.sh ejecuta seed_users al arrancar el contenedor.
# Déjalo en true para desarrollo local; ponlo en false (u omítelo) contra
# cualquier base de datos que no sea de prueba.
SEED_DEMO_DATA=true

DB_NAME=gacm_contracts
DB_USER=gacm
DB_PASSWORD=gacm
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
